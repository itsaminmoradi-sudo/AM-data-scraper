{
    "manifest_version": 3,
    "name": "AM Data Scraper",
    "version": "1.0",
    "description": "A high-performance data scraper with professional PDF reporting.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}